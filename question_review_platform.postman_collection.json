          "name": "11. Database health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health/",
            "description": "Public. Returns HTTP 200 with status=ok and database=ok when PostgreSQL is reachable.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
